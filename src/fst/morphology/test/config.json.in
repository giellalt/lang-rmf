{
    "analyser": "@abs_builddir@/../../analyser-gt-norm.hfstol",
    "generator": "@abs_builddir@/../../generator-gt-norm.hfstol",
    "lexcroot": "@abs_srcdir@/../root.lexc",
    "nouns": {
        "lexcfile": "@abs_srcdir@/../stems/nouns.lexc",
        "lemmatags": ["+N+Msc+Sg+Nom", "+N+Fem+Sg+Nom"]
    },
    "adjectives": {
        "lexcfile": "@abs_srcdir@/../stems/adjectives.lexc",
        "lemmatags": ["+A+Pos+Msc+Sg"]
    },
    "propernouns": {
        "lexcfile": "@abs_srcdir@/../stems/rmf-propernouns.lexc",
        "lemmatags": ["+N+Prop+Sem/Mal", "+N+Prop+Sem/Fem"]
    },
    "verbs": {
        "lexcfile": "@abs_srcdir@/../stems/verbs.lexc",
        "lemmatags": ["+V+Ind+Prs+Sg1"]
    },
    "otherlexcs": [
        "@abs_srcdir@/../stems/numerals.lexc",
        "@abs_srcdir@/../stems/pronouns.lexc",
        "@abs_srcdir@/../affixes/adjectives.lexc",
        "@abs_srcdir@/../affixes/nouns.lexc",
        "@abs_srcdir@/../affixes/prefixes.lexc",
        "@abs_srcdir@/../affixes/propernouns.lexc",
        "@abs_srcdir@/../affixes/symbols.lexc",
        "@abs_srcdir@/../affixes/verbs.lexc"
    ]
}
